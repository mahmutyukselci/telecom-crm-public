# ==========================================
# TELECOM CRM - CENTRAL CONFIGURATION (.env)
# ==========================================

# --- INFRASTRUCTURE SERVICES ---
POSTGRES_USER=telecom_user
POSTGRES_PASSWORD=telecom_password
POSTGRES_DB=telecom_db
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=admin_password
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
TEXTBEE_API_KEY=your-api-key

# --- MICROSERVICE COMMUNICATION ENDPOINTS ---
# (Currently using localhost since running locally; will switch to service names in Docker)
CATALOG_SERVICE_URL=http://localhost:8083
CUSTOMER_SERVICE_URL=http://localhost:8084
SUBSCRIPTION_SERVICE_URL=http://localhost:8082
NOTIFICATION_SERVICE_URL=http://localhost:8085

# Infrastructure Connection URLs (For Local Development)
POSTGRES_URL=jdbc:postgresql://localhost:5432/telecom_db
REDIS_HOST=localhost
REDIS_PORT=6379
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
LOKI_URL=http://telecom-loki-ddns:3100/loki/api/v1/push