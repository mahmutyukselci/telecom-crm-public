# ==========================================
# TELECOM CRM - CENTRAL CONFIGURATION (.env)
# ==========================================

# --- INFRASTRUCTURE SERVICES ---
POSTGRES_USER=telecom_user
POSTGRES_PASSWORD=telecom_password
POSTGRES_DB=telecom_db
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=admin_password
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
TEXTBEE_API_KEY=your-api-key

# --- MICROSERVICE COMMUNICATION ENDPOINTS ---
# Use Docker service names instead of localhost
CATALOG_SERVICE_URL=http://catalog-service:8083
CUSTOMER_SERVICE_URL=http://customer-service:8084
SUBSCRIPTION_SERVICE_URL=http://subscription-service:8082
NOTIFICATION_SERVICE_URL=http://notification-service:8085


# --- INFRASTRUCTURE CONNECTIONS (Dockerized) ---

# PostgreSQL (service name = postgres)
POSTGRES_URL=jdbc:postgresql://postgres:5432/telecom_db

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Kafka (service name = kafka)
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Loki (already correct if using container name)
LOKI_URL=http://loki:3100/loki/api/v1/push